[Unit]
Description=ShopBondhu To-Do Flask API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopbondhu
Group=shopbondhu
WorkingDirectory=/opt/shopbondhu/api
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/shopbondhu/todo.env
ExecStart=/opt/shopbondhu/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8000 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/shopbondhu

[Install]
WantedBy=multi-user.target
